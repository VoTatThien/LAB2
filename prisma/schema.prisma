generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Role {
  roleId   Int    @id @default(autoincrement()) @map("roleid")
  roleName String @unique @map("rolename") @db.VarChar(50)
  users    User[]

  @@map("roles")
}

model Membership {
  membershipId   Int    @id @default(autoincrement()) @map("mid")
  membershipName String @unique @map("mname") @db.VarChar(50)
  score          Int    @default(10)
  users          User[]

  @@map("memberships")
}

model User {
  userId       Int        @id @default(autoincrement()) @map("uid")
  username     String     @unique @db.VarChar(50)
  fullName     String     @map("fullname") @db.VarChar(100)
  password     String     @db.VarChar(255)
  roleId       Int        @map("roleid")
  membershipId Int        @map("mid")
  role         Role       @relation(fields: [roleId], references: [roleId])
  membership   Membership @relation(fields: [membershipId], references: [membershipId])
  orders       Order[]

  @@index([roleId])
  @@index([membershipId])
  @@map("users")
}

model Product {
  productId    Int           @id @default(autoincrement()) @map("pid")
  productName  String        @map("pname") @db.VarChar(100)
  price        Decimal       @db.Decimal(10, 2)
  quantity     Int
  orderDetails OrderDetail[]

  @@map("products")
}

model Order {
  orderId   Int           @id @default(autoincrement()) @map("oid")
  userId    Int           @map("uid")
  createdAt DateTime      @default(now()) @map("createdat")
  user      User          @relation(fields: [userId], references: [userId])
  details   OrderDetail[]
  shipments Shipment[]

  @@index([userId])
  @@map("orders")
}

model OrderDetail {
  orderId   Int     @map("oid")
  productId Int     @map("pid")
  quantity  Int     @map("qty")
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)
  order     Order   @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [productId])

  @@id([orderId, productId])
  @@index([productId])
  @@map("order_details")
}

enum ShipmentStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model Shipment {
  shipmentId Int            @id @default(autoincrement()) @map("shipid")
  orderId    Int            @map("oid")
  status     ShipmentStatus @default(PENDING)
  order      Order          @relation(fields: [orderId], references: [orderId], onDelete: Cascade)

  @@index([orderId])
  @@map("shipments")
}
